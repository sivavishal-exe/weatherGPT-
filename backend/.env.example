APP_NAME="WeatherGPT Intelligence Service"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./weathergpt.db"
# DATABASE_URL="postgresql+asyncpg://weathergpt:securepassword@localhost:5432/weathergpt_db"

# Redis Cache Configuration
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL_SECONDS=600

# Weather Provider Services
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
NOAA_ALERTS_BASE_URL="https://api.weather.gov"
OPENWEATHER_API_KEY=""

# Conversational LLM Settings
LLM_PROVIDER="grounded-weathergpt"
LLM_API_KEY=""
LLM_MODEL_NAME="gpt-4o-mini"

# Security & Limits
SECRET_KEY="dev-secret-key-change-in-production-weathergpt-2026"
RATE_LIMIT_PER_MINUTE=60
